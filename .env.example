# Salin jadi .env lalu isi yang perlu — .env sendiri diabaikan git.
# Semua opsional; yang kosong bikin endpoint terkait mati atau terbatas, bukan server gagal start.

PORT=3000

# Cookie premium bilibili.tv, buat buka kualitas 1080P ke atas di /api/download/bilibili.
# Ambil dari DevTools > Application > Cookies di www.bilibili.tv sesudah login.
BILIBILI_COOKIE=SESSDATA=...; bili_jct=...

# Prefix proxy khusus bilibili (API-nya nolak IP datacenter, mis. Vercel US).
# Kalau kosong, PROXY_URL di bawah yang dipakai.
BILIBILI_PROXY_URL=

# Prefix proxy global buat host yang memblokir IP server (BMKG, otakudesu, brave, dll).
PROXY_URL=

# Gateway Cloudflare Workers AI buat kategori cloudflare + ai/flux.
CLOUDFLARE_AI_URL=

# Token API Pinterest buat /api/s/pinterest-lens (PINTEREST_COOKIE opsional).
PINTEREST_TOKEN=
PINTEREST_COOKIE=

# Batas polling /api/download/ytmp3, dikali 1.5 detik.
YTMP3_MAX_POLL=18
