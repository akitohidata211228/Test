{
  "name": "react-example",
  "private": true,
  "version": "1.1.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && node server/bundleRouter.mjs && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "start": "node dist/server.cjs"
  },
  "dependencies": {
    "@faker-js/faker": "^9.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "axios": "^1.13.6",
    "axios-cookiejar-support": "^5.0.0",
    "cheerio": "^1.0.0-rc.12",
    "cookie": "^0.6.0",
    "crypto-js": "^4.2.0",
    "file-type": "^16.5.4",
    "form-data": "^4.0.0",
    "got": "^11.8.6",
    "jimp": "^0.22.10",
    "lucide-react": "^0.546.0",
    "moment": "^2.30.1",
    "needle": "^3.3.1",
    "node-fetch": "^2.7.0",
    "qrcode": "^1.5.4",
    "qs": "^6.14.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tough-cookie": "^4.1.3",
    "uri-js": "^4.4.1",
    "user-agents": "^1.1.607",
    "vite": "^8.3.0",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/express": "^4.17.21"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
